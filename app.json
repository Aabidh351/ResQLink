{
  "expo": {
    "name": "ResQLink",
    "slug": "resqlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "resqlink",
    "android": {
      "package": "com.resqlink.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1E8D6"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
