{
  "expo": {
    "name": "ResQLink",
    "slug": "resqlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "resqlink",
    "icon": "./assets/images/resqlink-icon.png",
    "android": {
      "package": "com.resqlink.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/resqlink-icon.png",
        "backgroundColor": "#1E4D5A"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
